    const d = dict[I18N.lang] || dict.es;
    let v = d[k];
    if (v == null) v = dict.es[k];
    if (v == null) v = k;
    if (args != null) {
      const list = Array.isArray(args) ? args : [args];
      v = String(v).replace(/\{(\d+)\}/g, (m, i) => {
        const val = list[Number(i)];
        return val == null ? '' : String(val);
      });
    }
    return v;
  }
};

// --- CONFIGURACIÓN BASE ---
const MISSION = { name: 'RESCUE-X', astronaut: 'ASTR-02 · HALLEY', location: 'Mare Imbrium — Sector 7 / EVA-04' };
const BASE = { hr: 72, spo2: 97.8, press: 101.3, temp: 36.8, co2: 0.42, batt: 86, activity: 42, orient: 8 };
const RULE = { hrLow: 52, hrHigh: 128, hrHighCrit: 138, spo2Warn: 93, pressWarn: 84, pressCrit: 68, co2Warn: 1.1, co2Crit: 2.0, battWarn: 25, battCrit: 12, actStill: 6, orientFall: 58, persist: 5 };

// --- MÁQUINA DE ESTADOS ---
const STATES = {
  EXPLORATION: 'EXPLORACIÓN',
  IMPACT: 'IMPACTO DETECTADO',
  VERIFYING: 'VERIFICANDO RESPUESTA',
  EMERGENCY: 'EMERGENCIA ACTIVA',
  RESCUE_SENT: 'SOLICITANDO RESCATE',
  RESCUE_ARRIVAL: 'RESCATE EN CAMINO',
  CLOSED: 'INCIDENTE CERRADO'
};

let systemState = {
  current: STATES.EXPLORATION,
  t: 0,
  comm: true,
  suit: 'normal',
  sim: Object.assign({}, BASE),
  targets: Object.assign({}, BASE),
  scenario: null,
  metrics: { scenarios: 0, alerts: 0 },
  soundOn: true
};

// --- AUDIO Y COMUNICACIONES ---
const AudioContext = window.AudioContext || window.webkitAudioContext;
let audioCtx = null;

function initAudio() { if (!audioCtx) audioCtx = new AudioContext(); }

function playAlert(freqs, dur, interval) {
  initAudio();
  if (audioCtx.state === 'suspended') audioCtx.resume();
  let t = audioCtx.currentTime;
  freqs.forEach((f, i) => {
    const o = audioCtx.createOscillator();
    const g = audioCtx.createGain();
    o.frequency.value = f;
    g.gain.value = 0.1;
    o.connect(g);
    g.connect(audioCtx.destination);
    o.start(t + i * interval);
    o.stop(t + dur + i * interval);
    t += interval;
  });
}

// --- LÓGICA DE SIMULACIÓN ---

function logToConsole(msg, severity = 'info') {
  const con = $('emergencyConsole');
  const line = document.createElement('div');
  line.className = `console-line ${severity === 'crit' ? 'sev-crit' : severity === 'warn' ? 'sev-warn' : ''}`;
  line.textContent = `[${new Date().toLocaleTimeString()}] ${msg}`;
  con.prepend(line);
}

function cargarEscenario(scenario) {
  systemState.scenario = scenario;
  systemState.metrics.scenarios++;
  
  const profiles = {
    normal: { hr: 72, spo2: 98, press: 101, temp: 36.6, co2: 0.4, batt: 80, activity: 40, orient: 5 },
    collapse: { hr: 45, spo2: 91, press: 101, temp: 36.2, co2: 0.5, batt: 70, activity: 2, orient: 10 },
    fall: { hr: 110, spo2: 95, press: 101, temp: 36.6, co2: 0.4, batt: 65, activity: 0, orient: 90 },
    physio: { hr: 145, spo2: 94, press: 101, temp: 38.5, co2: 0.4, batt: 60, activity: 10, orient: 15 },
    pressure: { hr: 115, spo2: 88, press: 60, temp: 35.5, co2: 0.4, batt: 50, activity: 15, orient: 20 },
    co2: { hr: 105, spo2: 92, press: 101, temp: 36.8, co2: 2.5, batt: 40, activity: 10, orient: 10 },
    comm: { hr: 72, spo2: 98, press: 101, temp: 36.6, co2: 0.4, batt: 80, activity: 40, orient: 5, comm: false },
    battery: { hr: 75, spo2: 98, press: 101, temp: 36.6, co2: 0.4, batt: 10, activity: 30, orient: 5 }
  };

  const p = profiles[scenario] || profiles.normal;
  systemState.targets = Object.assign({}, p);
  
  if (scenario === 'comm') systemState.comm = false;
  if (scenario === 'normal') systemState.comm = true;

  logToConsole(`ESCENARIO ACTIVADO: ${scenario.toUpperCase()}`);
  
  // Trigger Story State
  if (scenario === 'normal') {
    systemState.current = STATES.EXPLORATION;
    window.updateAstronautState('NORMAL');
  } else {
    systemState.current = STATES.IMPACT;
    window.updateAstronautState('COLLAPSED');
    playAlert([200, 150, 100], 200, 300);
    logToConsole('¡IMPACTO DETECTADO! Iniciando protocolo de seguridad...', 'crit');
  }
}

function simulationLoop() {
  systemState.t += 0.1;
  
  // Interpolación de sensores
  for (let k in systemState.sim) {
    if (systemState.targets[k] !== undefined) {
      systemState.sim[k] += (systemState.targets[k] - systemState.sim[k]) * 0.1;
    }
  }
  
  checkRules();
  actualizarUI();
}

function checkRules() {
  let critical = false;
  let warn = false;

  if (systemState.sim.hr < RULE.hrLow || systemState.sim.hr > RULE.hrHigh) warn = true;
  if (systemState.sim.spo2 < RULE.spo2Warn) warn = true;
  if (systemState.sim.press < RULE.pressWarn) warn = true;
  if (systemState.sim.co2 > RULE.co2Warn) warn = true;
  if (systemState.sim.batt < RULE.battWarn) warn = true;
  if (systemState.sim.press < RULE.pressCrit) critical = true;

  if (critical) systemState.suit = 'critical';
  else if (warn) systemState.suit = 'attention';
  else systemState.suit = 'normal';
}

function actualizarUI() {
  $('vAstronaut').textContent = MISSION.astronaut;
  $('vLocation').textContent = MISSION.location;
  $('missionClock').textContent = `T+${systemState.t.toFixed(1)}`;
  
  const commPill = $('commStatus');
  commPill.textContent = systemState.comm ? 'ENLACE NOMINAL' : 'ENLACE INTERRUMPIDO';
  commPill.className = `pill ${systemState.comm ? 'ok' : 'danger'}`;
  
  const inds = {
    vHr: systemState.sim.hr.toFixed(0), 
    vSpo2: systemState.sim.spo2.toFixed(1), 
    vPress: systemState.sim.press.toFixed(1),
    vCo2: systemState.sim.co2.toFixed(2), 
    vBatt: systemState.sim.batt.toFixed(0) + '%', 
    vTemp: systemState.sim.temp.toFixed(1),
    vOrient: systemState.sim.orient.toFixed(0) + '°'
  };
  for (let id in inds) {
    const el = $(id);
    if (el) el.textContent = inds[id];
  }
  $('vActivity').textContent = systemState.sim.activity > 10 ? 'ACTIVO' : 'INMÓVIL';
  
  $('suitName').textContent = systemState.suit.toUpperCase();
  $('suitName').className = `pill ${systemState.suit === 'normal' ? 'ok' : 'danger'}`;
}

function cambiarTab(tabId) {
  document.querySelectorAll('.tab').forEach(section => {
    section.hidden = true;
    section.classList.remove('active');
  });
  const target = document.getElementById('tab-' + tabId);
  if (target) {
    target.hidden = false;
    target.classList.add('active');
  }
  document.querySelectorAll('.nav-tab').forEach(b => {
    b.classList.toggle('active', b.dataset.tab === tabId);
  });
}

function filtrarHistorial(filter) {
  document.querySelectorAll('.filter').forEach(b => {
    b.classList.toggle('active', b.dataset.filter === filter);
  });
}

function actualizarIdioma() {
  document.querySelectorAll('[data-i18n]').forEach(el => {
    el.textContent = I18N.t(el.getAttribute('data-i18n'));
  });
  document.querySelectorAll('[data-i18n-html]').forEach(el => {
    el.innerHTML = I18N.t(el.getAttribute('data-i18n-html'));
  });
}

document.addEventListener('DOMContentLoaded', () => {
  initAudio();
  actualizarIdioma();
  setInterval(simulationLoop, 100);
  
  // Init 3D
  if (window.initLunarScene) window.initLunarScene();
});

// Eventos
document.querySelectorAll('[data-scenario]').forEach(b => {
  b.addEventListener('click', () => cargarEscenario(b.dataset.scenario));
});

document.querySelectorAll('.nav-tab').forEach(b => {
  b.addEventListener('click', () => cambiarTab(b.dataset.tab));
});

document.querySelectorAll('.filter').forEach(b => {
  b.addEventListener('click', () => filtrarHistorial(b.dataset.filter));
});

window.I18N = I18N;
window.cambiarTab = cambiarTab;
