# Copia este archivo como `.env` si quieres usar OpenAI para la IA de alerta.
# NUNCA subas tu clave real a un repositorio ni la pongas en el navegador.
# La aplicación funciona perfectamente SIN este archivo (IA heurística local).

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Opcionales
PORT=3000
HOST=127.0.0.1
